# ---------------------------------------------------------------
# Copy this file to `.env` (same folder) and adjust the values.
# Both apps and the Prisma CLI read this single root .env file.
# ---------------------------------------------------------------

# --- Backend (server-only, NEVER prefix with NEXT_PUBLIC_) ---
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resource_reservation_db
# Separate database used by the backend integration tests (it is wiped on every test run!).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resource_reservation_test
# Separate database used by the Playwright end-to-end tests (also wiped on every run!).
E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resource_reservation_e2e
# Browser origins allowed to call the backend API (CORS): user website, admin website.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
# The one administrator account (the admin website has login only, no signup).
# Use a strong password; the account is created/updated from these values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Frontend (public, embedded in browser JavaScript) ---
# Base URL of the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# IANA timezone used to display and enter reservation times, e.g. Asia/Colombo, Europe/London.
NEXT_PUBLIC_APP_TIMEZONE=UTC
