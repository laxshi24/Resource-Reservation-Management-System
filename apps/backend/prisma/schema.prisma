// Prisma schema - Resource Reservation Management System.
// See docs/er-diagram.md for the diagram and docs/architecture.md for design notes.
//
// Conventions:
// - UUID primary keys generated by the application.
// - snake_case table/column names in PostgreSQL, camelCase in TypeScript.
// - Every timestamp is TIMESTAMPTZ (an unambiguous instant, stored in UTC).
// - Constraints Prisma cannot express (CHECK, case-insensitive UNIQUE, EXCLUDE)
//   live in hand-written SQL inside the versioned migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// USER books resources; ADMIN also manages resources and all reservations.
enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

/// Which website a session belongs to. Each site has its own login and cookie.
enum Portal {
  USER
  ADMIN

  @@map("portal")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(100)
  /// Stored lower-cased; unique.
  email        String        @unique @db.VarChar(254)
  /// scrypt hash ("scrypt$N$r$p$salt$hash"); the plain password is never stored.
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  reservations Reservation[]

  @@map("users")
}

/// Server-side login session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  portal    Portal
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ResourceCategory {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(50)
  slug        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  resources   Resource[]

  @@map("resource_categories")
}

model Resource {
  id           String           @id @default(uuid()) @db.Uuid
  /// Unique ignoring case (see migration: resources_name_lower_key).
  name         String           @db.VarChar(100)
  description  String?          @db.VarChar(1000)
  location     String?          @db.VarChar(150)
  /// Number of people the resource holds; null when not applicable (e.g. a projector).
  capacity     Int?
  isActive     Boolean          @default(true) @map("is_active")
  categoryId   String           @map("category_id") @db.Uuid
  // A category that still has resources cannot be deleted.
  category     ResourceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  reservations Reservation[]

  @@index([categoryId, isActive])
  @@index([isActive, name])
  @@map("resources")
}

/// CONFIRMED -> CANCELLED is the only allowed transition (cancellation is final).
enum ReservationStatus {
  CONFIRMED
  CANCELLED

  @@map("reservation_status")
}

model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  resourceId         String            @map("resource_id") @db.Uuid
  // Reservations are history: a resource that has any cannot be deleted.
  resource           Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Account that made the booking. Null only for bookings created before accounts existed.
  userId             String?           @map("user_id") @db.Uuid
  user               User?             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Display name of the person the booking is for (defaults to the account's name).
  bookedBy           String            @map("booked_by") @db.VarChar(100)
  purpose            String?           @db.VarChar(500)
  /// Inclusive start of the half-open interval [startTime, endTime).
  startTime          DateTime          @map("start_time") @db.Timestamptz(3)
  /// Exclusive end: a booking ending at 11:00 does not clash with one starting at 11:00.
  endTime            DateTime          @map("end_time") @db.Timestamptz(3)
  status             ReservationStatus @default(CONFIRMED)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(300)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([resourceId, startTime])
  @@index([userId, startTime])
  @@index([status, startTime])
  @@index([startTime])
  @@map("reservations")
}
